---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import sacrements from "../data/sacrements/sacrements.json";
---

<BaseLayout title="Sacrements — Saint Louis des Français">
  <Header />

  <main>

    <!-- PAGE HEADER -->
    <div class="page-header">
      <div class="container">
        <span class="eyebrow">VIE CHRÉTIENNE</span>
        <h1>Sacrements</h1>
        <p>Les grandes étapes de la vie chrétienne célébrées en français.</p>
      </div>
    </div>

    <!-- BAPTÊME -->
    <section class="section">
  <div class="container">
    <div class="text reveal">
      <span class="eyebrow">BAPTÊME</span>
      <h2>{sacrements.bapteme.titulo}</h2>
      <p>{sacrements.bapteme.texto1}</p>
      <p>{sacrements.bapteme.texto2}</p>
    </div>
  </div>
</section>

    <!-- MARIAGE -->
    <section class="section">
  <div class="container">
    <div class="text reveal">
      <span class="eyebrow">MARIAGE</span>
      <h2>{sacrements.mariage.titulo}</h2>
      <p>{sacrements.mariage.texto1}</p>
      <p>{sacrements.mariage.texto2}</p>
    </div>
  </div>
</section>

    <!-- ADORATION -->
    <section class="section">
  <div class="container">
    <div class="text reveal">
      <span class="eyebrow">ADORATION</span>
      <h2>{sacrements.adoration.titulo}</h2>
      <p>{sacrements.adoration.texto}</p>
    </div>
  </div>
</section>

    <!-- RÉCONCILIATION -->
    <section class="section">
  <div class="container reveal">
    <span class="eyebrow">RÉCONCILIATION</span>
    <h2 class="section-title">Sacrement de la réconciliation</h2>
    <p class="liturgie-intro">{sacrements.reconciliation.texto_intro}</p>
    <div class="reconciliation-grid">
      {sacrements.reconciliation.cards.map((card) => (
        <div class="reconciliation-card">
          <span class="reconciliation-titre">{card.titre}</span>
          <span class="reconciliation-horaire">{card.horaire}</span>
          <p>{card.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
  
  

    <!-- CTA -->
    <section class="cta reveal">
      <div class="container cta-inner">
        <div class="cta-text">
          <h2>Une question sur un sacrement ?</h2>
          <p>N'hésitez pas à nous contacter ou à vous présenter après la messe.</p>
        </div>
        <a href="/contact" class="cta-button">Nous contacter</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>