<script is:inline>
  function setLang(lang) {
    document.getElementById('content-fr').style.display = lang === 'fr' ? 'block' : 'none';
    document.getElementById('content-es').style.display = lang === 'es' ? 'block' : 'none';
    document.getElementById('btnFR').classList.toggle('active', lang === 'fr');
    document.getElementById('btnES').classList.toggle('active', lang === 'es');
    document.getElementById('indexFR').style.display = lang === 'fr' ? 'flex' : 'none';
    document.getElementById('indexES').style.display = lang === 'es' ? 'flex' : 'none';

    // Botón flotante
    const donateBtn = document.getElementById('donateFloatBtn');
    if (donateBtn) {
      donateBtn.href = lang === 'fr' ? '#fr-7' : '#es-7';
      donateBtn.textContent = lang === 'fr' ? 'Faire un don' : 'Donar';
    }
  }

  // Donate float visibility — esto sí va fuera de setLang
  const donateFloat = document.getElementById('donateFloat');
  if (donateFloat) {
    window.addEventListener('scroll', function() {
      donateFloat.classList.toggle('visible', window.scrollY > 300);
    });
  }

  // Share modal
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('shareModal');
  const closeBtn = document.getElementById('shareModalClose');
  const copyBtn = document.getElementById('copyLinkBtn');
  const copyText = document.getElementById('copyLinkText');
  const shareBtn = document.getElementById('shareBtn');
  const shareBtnES = document.getElementById('shareBtnES');

  function openShare(lang) {
    document.getElementById('shareModalTitle').textContent = lang === 'fr' ? 'Partager ce projet' : 'Compartir este proyecto';
    copyText.textContent = lang === 'fr' ? 'Copier le lien' : 'Copiar enlace';
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  if (shareBtn) shareBtn.addEventListener('click', () => openShare('fr'));
  if (shareBtnES) shareBtnES.addEventListener('click', () => openShare('es'));
  if (closeBtn) closeBtn.addEventListener('click', () => { modal.classList.remove('open'); document.body.style.overflow = ''; });
  if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) { modal.classList.remove('open'); document.body.style.overflow = ''; }});
  if (copyBtn) copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText('https://paroisse.stlouisfrancais.org/renovation');
    copyText.textContent = '✓ Copié !';
    setTimeout(() => { copyText.textContent = document.getElementById('btnFR').classList.contains('active') ? 'Copier le lien' : 'Copiar enlace'; }, 2000);
  });
});

function toggleCategoria(header) {
  const content = header.nextElementSibling;
  const arrow = header.querySelector('.media-categoria-arrow');
  const isOpen = content.style.display !== 'none';

  // Cerrar todas las demás
  document.querySelectorAll('.media-categoria-content').forEach(c => {
    c.style.display = 'none';
  });
  document.querySelectorAll('.media-categoria-arrow').forEach(a => {
    a.classList.remove('open');
  });

  // Abrir la clickada si estaba cerrada
  if (!isOpen) {
    content.style.display = 'block';
    arrow.classList.add('open');
  }
}
</script>

<script is:inline>
const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vQtfPy2zuJrGy8KD9avNGRprZDa_qDv6j_oHnvWVj1Jq8qlQRHQHNbYfxiqJElOZb-UNcmE6wIQFby1/pub?output=csv';
const OBJETIVO = 500000;

async function loadDonations() {
  try {
    const res = await fetch(CSV_URL + '&t=' + Date.now());
    const text = await res.text();
    const rows = text.trim().split('\n').slice(1).map(r => r.split(','));

const dons = rows.filter(r => !r[3] || !r[3].trim().toLowerCase().includes('activit'));
const activites = rows.filter(r => r[3] && r[3].trim().toLowerCase().includes('activit'));

  const labels = [], cumuls = [];
let lastCumulEur = 0, lastCumulNum = 0, lastDonMoyen = 0;
let acumuladoEur = 0, acumuladoNum = 0;

dons.forEach(row => {
  if (row.length < 3) return;
  const fecha = row[0].trim().replace(/"/g,'');
  const donsSemaine = parseFloat(row[2]?.replace(/[^0-9.]/g, '')) || 0;
  const donateurs = parseInt(row[1]) || 0;
  
  if (donsSemaine > 0 || donateurs > 0) {
    acumuladoEur += donsSemaine;
    acumuladoNum += donateurs;
    labels.push(fecha);
    cumuls.push(acumuladoEur);
    lastCumulEur = acumuladoEur;
    lastCumulNum = acumuladoNum;
    lastDonMoyen = acumuladoNum > 0 ? acumuladoEur / acumuladoNum : 0;
  }
});
    let totalActivites = 0;
    let numActivites = activites.length;
    activites.forEach(row => {
      totalActivites += parseFloat(row[2]?.replace(/[^0-9.]/g, '')) || 0;
    });
    const moyenneActivites = numActivites > 0 ? totalActivites / numActivites : 0;

    const totalGeneral = lastCumulEur + totalActivites;
    const pct = Math.min((totalGeneral / OBJETIVO) * 100, 100).toFixed(1);
    const fmt = n => n.toLocaleString('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';

    // FR
    document.getElementById('totalCollecte').textContent = fmt(totalGeneral);
    document.getElementById('totalDons').textContent = fmt(lastCumulEur);
    document.getElementById('totalDonateurs').textContent = lastCumulNum;
    document.getElementById('donMoyen').textContent = fmt(lastDonMoyen);
    document.getElementById('progresoFill').style.width = pct + '%';
    document.getElementById('progresoPercent').textContent = pct + '%';
    document.getElementById('totalActivitesFR').textContent = numActivites;
    document.getElementById('montantActivitesFR').textContent = fmt(totalActivites);
    document.getElementById('moyenneActivitesFR').textContent = fmt(moyenneActivites);

    // ES
    document.getElementById('totalCollecteES').textContent = fmt(totalGeneral);
    document.getElementById('totalDonsES').textContent = fmt(lastCumulEur);
    document.getElementById('totalDonateursES').textContent = lastCumulNum;
    document.getElementById('donMoyenES').textContent = fmt(lastDonMoyen);
    document.getElementById('progresoFillES').style.width = pct + '%';
    document.getElementById('progresoPercentES').textContent = pct + '%';
    document.getElementById('totalActivitesES').textContent = numActivites;
    document.getElementById('montantActivitesES').textContent = fmt(totalActivites);
    document.getElementById('moyenneActivitesES').textContent = fmt(moyenneActivites);

    // Botón flotante
    const floatFill = document.getElementById('donateFloatFill');
    const floatPct = document.getElementById('donateFloatPct');
    if (floatFill) floatFill.style.width = pct + '%';
    if (floatPct) floatPct.textContent = pct + '%';

    // Gráfico
    if (typeof Chart !== 'undefined') {
  // Preparar puntos de actividades
  const actLabels = activites.map(row => row[0].trim().replace(/"/g,''));
  const actImportes = activites.map(row => parseFloat(row[2]?.replace(/[^0-9.]/g, '')) || 0);

  // Combinar todas las fechas para el eje X
  const todasFechas = [...labels, ...actLabels].sort((a, b) => {
  const [da, ma, ya] = a.split('/').map(Number);
  const [db, mb, yb] = b.split('/').map(Number);
  return new Date(ya, ma-1, da) - new Date(yb, mb-1, db);
});
  const uniqueFechas = [...new Set(todasFechas)];

  // Mapear cumuls al eje X completo
 const cumuslMapped = uniqueFechas.map(f => {
  const i = labels.indexOf(f);
  return i !== -1 ? cumuls[i] : undefined;
});

// Rellenar huecos con el último valor conocido
let lastKnown = null;
const cumuslFilled = cumuslMapped.map(v => {
  if (v !== undefined) { lastKnown = v; return v; }
  return lastKnown;
});

  // Mapear actividades al eje X completo
  const actMapped = uniqueFechas.map(f => {
    const i = actLabels.indexOf(f);
    return i !== -1 ? actImportes[i] : null;
  });

  const totalLabels = uniqueFechas.length;
  const chartConfig = {
    type: 'line',
    data: {
      labels: uniqueFechas,
      datasets: [
        {
          label: 'Cumul dons €',
          data: cumuslFilled,
          borderColor: '#7a1f1f',
          backgroundColor: 'rgba(122,31,31,0.1)',
          tension: 0.3,
          fill: true,
          pointRadius: 3,
          spanGaps: true,
        },
        {
          label: 'Activités €',
          data: actMapped,
          borderColor: '#2e7d32',
          backgroundColor: 'rgba(46,125,50,0.15)',
          tension: 0,
          fill: false,
          pointRadius: 7,
          pointStyle: 'star',
          showLine: false,
          spanGaps: false,
        },
        {
          label: 'Objectif 500 000 €',
          data: new Array(uniqueFechas.length).fill(OBJETIVO),
          borderColor: '#b08a5a',
          borderDash: [6, 4],
          pointRadius: 0,
          fill: false,
        }
      ]
    },
    options: {
      responsive: true,
      plugins: { legend: { position: 'top' } },
      scales: {
        x: { ticks: { minRotation: 45, maxRotation: 45, font: { size: 10 }, autoSkip: true, maxTicksLimit: totalLabels } },
        y: { beginAtZero: true, max: 500000, ticks: { callback: v => v.toLocaleString('fr-FR') + ' €' } }
      }
    }
  };
  new Chart(document.getElementById('donationsChart'), chartConfig);
  new Chart(document.getElementById('donationsChartES'), { ...chartConfig, data: JSON.parse(JSON.stringify(chartConfig.data)) });
}

  } catch(e) { console.error('Error cargando datos:', e); }
}

const script = document.createElement('script');
script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
script.onload = loadDonations;
document.head.appendChild(script);
</script>

