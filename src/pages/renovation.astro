  function updateLightbox() {
    const img = grupoActual[current];
    const lang = getLang();
    document.getElementById('fresqueLbImg').src = img.src;
    document.getElementById('fresqueLbImg').alt = lang === 'fr' ? img.captionFR : img.captionES;
