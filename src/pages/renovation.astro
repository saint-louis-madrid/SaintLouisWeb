---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Projet Rénovation 2026 — Saint Louis des Français">
  <Header />

  <main>

    <!-- HERO -->
    <section class="hero-carousel">
      <div class="carousel-track" id="carouselTrack">
        <div class="carousel-slide" style="background-image: url('/images/iglesia.jpg')"></div>
       
      </div>
      <div class="carousel-overlay">
        <div class="container hero-content">
          <h1 style="color:white; font-size:clamp(1.8rem,4vw,3rem); margin:0.4rem 0 0.5rem;">
            Projet Rénovation 2026
          </h1>
        </div>
      </div>
      <button class="carousel-btn carousel-btn--prev" id="prevBtn">&#8592;</button>
      <button class="carousel-btn carousel-btn--next" id="nextBtn">&#8594;</button>
      <div class="carousel-dots" id="carouselDots">
        <span class="carousel-dot active"></span>
        <span class="carousel-dot"></span>
        <span class="carousel-dot"></span>
      </div>
    </section>

    <!-- SELECTOR DE IDIOMA -->
    <div class="lang-selector-bar">
      <div class="container">
        <button class="lang-selector-btn active" id="btnFR" onclick="setLang('fr')">
          🇫🇷 Français
        </button>
        <button class="lang-selector-btn" id="btnES" onclick="setLang('es')">
          🇪🇸 Español
        </button>
      </div>
    </div>

    <!-- ÍNDICE -->
    <div class="renovation-index">
      <div class="container">
        <div class="index-links" id="indexFR">
          <a href="#fr-1">1. Je donne</a>
          <a href="#fr-2">2. Collaborer</a>
          <a href="#fr-3">3. Fiscal</a>
          <a href="#fr-4">4. Histoire</a>
          <a href="#fr-5">5. Travaux</a>
          <a href="#fr-6">6. Projet</a>
          <a href="#fr-7">7. Vidéos</a>
          <a href="#fr-8">8. Liban</a>
          <a href="#fr-9">9. Ressources</a>
          <a href="#fr-10">10. Résultats</a>
        </div>
        <div class="index-links" id="indexES" style="display:none;">
          <a href="#es-1">1. Donar</a>
          <a href="#es-2">2. Colaborar</a>
          <a href="#es-3">3. Fiscal</a>
          <a href="#es-4">4. Historia</a>
          <a href="#es-5">5. Obras</a>
          <a href="#es-6">6. Proyecto</a>
          <a href="#es-7">7. Vídeos</a>
          <a href="#es-8">8. Líbano</a>
          <a href="#es-9">9. Recursos</a>
          <a href="#es-10">10. Resultados</a>
        </div>
      </div>
    </div>

    <!-- BOTÓN VOLVER ARRIBA -->
    <button class="back-to-top" id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>

    <!-- ===== CONTENIDO FR ===== -->
    <div id="content-fr">

      <section class="section" id="fr-1">
        <div class="container reveal">
          <span class="eyebrow">1. JE DONNE</span>
          <h2 class="section-title">Je donne</h2>
          <p class="liturgie-intro">
            Vous pouvez soutenir le projet de la paroisse de plusieurs manières.<br/>
            ⚠️ Attention : prenez connaissance des avantages fiscaux au point 3, pour mieux nous aider.
          </p>
          <div class="renovation-bizum">
            <span class="don-label">Bizum solidaire – code : 13902</span>
            <span class="bizum-code">13902</span>
            <p>
              Dans l'app Bizum, choisissez « Donner à une ONG », « Bizum solidaire » ou « Donación », 
              puis entrez le code <strong>13902</strong>. Disponible seulement depuis l'Espagne.
            </p>
          </div>
          <div class="don-grid">
            <div class="don-card">
              <span class="don-label">Virement bancaire</span>
              <span class="don-iban">ES98 0049 6791 7629 1601 6891</span>
              <span class="don-note">BIC : BSCHESMM</span>
            </div>
            <div class="don-card">
              <span class="don-label">Carte bancaire</span>
              <span class="don-note">
                Lien en préparation. ⚠️ Une commission est appliquée sur les dons par carte.
              </span>
            </div>
          </div>
          <p class="don-contact">
            Contact : <a href="mailto:paroissesaintlouismadrid@gmail.com">paroissesaintlouismadrid@gmail.com</a>
          </p>
        </div>
      </section>

      <section class="section" id="fr-2">
        <div class="container reveal">
          <span class="eyebrow">2. AUTRES MOYENS DE COLLABORER</span>
          <h2 class="section-title">Autres moyens de collaborer</h2>
          <p>
            Nous souhaitons ouvrir le plus largement possible notre rayon d'action. Pensez à toutes 
            les personnes qui seront heureuses de participer à ce beau projet : famille, amis, parrains, 
            marraines, etc. Cette multitude de petites aides peuvent faire la différence.
          </p>
          <p>
            Nous cherchons aussi de <strong>grands donateurs</strong>. Si vous pensez avoir accès à 
            une personne pouvant faire un grand don, contactez le père Rodrigo pour organiser une 
            présentation personnalisée.
          </p>
          <p>Faites connaître ce beau projet ! Partagez le lien de cette page !</p>
        </div>
      </section>

      <section class="section" id="fr-3">
        <div class="container reveal">
          <span class="eyebrow">3. LES AVANTAGES FISCAUX</span>
          <h2 class="section-title">Les avantages fiscaux</h2>
          <h3 class="renovation-subtitle">Si vous êtes imposable en Espagne :</h3>
          <p class="liturgie-intro">
            <strong>80%</strong> de réduction fiscale sur les premiers <strong>250€</strong> et 
            <strong>40%</strong> pour le reste (<strong>45%</strong> si le don se répète pendant 3 ans).
          </p>
          <div class="fiscal-grid">
            <div class="fiscal-card">
              <span class="fiscal-don">Don 500 €</span>
              <span class="fiscal-coste">Coût réel <strong>200 €</strong></span>
              <span class="fiscal-reduccion">Réduction 300 €</span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Don 1 000 €</span>
              <span class="fiscal-coste">Coût réel <strong>500 €</strong></span>
              <span class="fiscal-reduccion">Réduction 500 €</span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Don 2 000 €</span>
              <span class="fiscal-coste">Coût réel <strong>1 100 €</strong></span>
              <span class="fiscal-reduccion">Réduction 900 €</span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Don 3 000 €</span>
              <span class="fiscal-coste">Coût réel <strong>1 700 €</strong></span>
              <span class="fiscal-reduccion">Réduction 1 300 €</span>
            </div>
          </div>
          <h3 class="renovation-subtitle">Si vous êtes imposable en France :</h3>
          <p class="liturgie-intro">
            <strong>66%</strong> sur l'ensemble du don. Limite : 20% du revenu imposable.
          </p>
          <div class="fiscal-grid">
            <div class="fiscal-card">
              <span class="fiscal-don">Don 500 €</span>
              <span class="fiscal-coste">Coût réel <strong>170 €</strong></span>
              <span class="fiscal-reduccion">Réduction 330 €</span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Don 1 000 €</span>
              <span class="fiscal-coste">Coût réel <strong>340 €</strong></span>
              <span class="fiscal-reduccion">Réduction 660 €</span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Don 2 000 €</span>
              <span class="fiscal-coste">Coût réel <strong>680 €</strong></span>
              <span class="fiscal-reduccion">Réduction 1 320 €</span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Don 3 000 €</span>
              <span class="fiscal-coste">Coût réel <strong>1 020 €</strong></span>
              <span class="fiscal-reduccion">Réduction 1 980 €</span>
            </div>
          </div>
          <p class="liturgie-note">
            "Un don à une paroisse en Espagne peut être déductible en France si cette paroisse 
            est reconnue comme équivalente à un organisme d'intérêt général français."
          </p>
        </div>
      </section>

      <section class="section" id="fr-4">
        <div class="container reveal">
          <span class="eyebrow">4. SAINT-LOUIS-DES-FRANÇAIS</span>
          <h2 class="section-title">Un lieu emblématique</h2>
          <p>
            Depuis plus de 400 ans, au cœur de Madrid, la paroisse Saint-Louis-des-Français est 
            un point de repère pour des milliers de familles francophones. Bien plus qu'un bâtiment, 
            c'est un lieu de foi, un espace de rencontre, un pont entre les cultures.
          </p>
          <p>
            Soutenir ce projet, c'est préserver un patrimoine vivant, faire grandir une communauté 
            et transmettre une histoire.
          </p>
        </div>
      </section>

      <section class="section" id="fr-5">
        <div class="container reveal">
          <span class="eyebrow">5. POURQUOI CES TRAVAUX ?</span>
          <h2 class="section-title">Pourquoi ces travaux ?</h2>
          <p>
            L'église nécessite une rénovation importante pour répondre aux normes de sécurité 
            (anti-incendie), environnementales (isolation et climatisation) et adapter les espaces 
            aux besoins actuels. Ces travaux embelliront l'église grâce à une monumentale catéchèse 
            pictorique et une statue-reliquaire de Saint Louis.
          </p>
          <p>
            Ces travaux témoignent de la confiance placée dans la mission de notre Église : 
            loin de disparaître, nous sommes en croissance.
          </p>
        </div>
      </section>

      <section class="section" id="fr-6">
        <div class="container reveal">
          <span class="eyebrow">6. PROJET DÉTAILLÉ</span>
          <h2 class="section-title">Projet détaillé</h2>
          <h3 class="renovation-subtitle">La rénovation de l'église :</h3>
          <div class="renovation-lista">
            <span>Isolation thermique complète</span>
            <span>Climatisation par aérothermie</span>
            <span>Nouveau faux-plafond avec sécurité incendie</span>
            <span>Décoration artistique et catéchétique</span>
            <span>Éclairage professionnel</span>
            <span>Amélioration acoustique</span>
            <span>Nouveaux bancs avec prie-Dieu intégré</span>
            <span>Sacristie rénovée et unifiée</span>
            <span>Câblage pour retransmissions</span>
            <span>Systèmes de sécurité</span>
            <span>Rénovation de l'orgue</span>
            <span>Création d'un columbarium</span>
            <span>Statue de Saint Louis avec reliquaire</span>
          </div>
          <h3 class="renovation-subtitle">Les espaces paroissiaux :</h3>
          <div class="renovation-lista">
            <span>Salles modulables pour les activités</span>
            <span>Sas d'entrée vers la salle Saureulx</span>
            <span>Grande salle rénovée et lumineuse</span>
            <span>Cuisine et bar fonctionnels</span>
            <span>Studio de création de contenus</span>
            <span>Nouveaux sanitaires accessibles</span>
            <span>Wifi et équipements adaptés</span>
            <span>Espaces de rangement optimisés</span>
          </div>
          <h3 class="renovation-subtitle">Passerelle d'accès ♿ :</h3>
          <p>Une passerelle accessible reliera l'église à la résidence Saint-Louis.</p>
          <h3 class="renovation-subtitle">Une fresque au cœur de la prière :</h3>
          <p>Une grande fresque retracera l'histoire du Salut, de l'Ancien au Nouveau Testament.</p>
        </div>
      </section>

      <section class="section" id="fr-7">
        <div class="container reveal">
          <span class="eyebrow">7. PROJET EN IMAGES ET VIDÉOS 🎥</span>
          <h2 class="section-title">Projet en images et vidéos</h2>
          <p class="liturgie-intro">
            Découvrez notre projet sur notre chaîne 
            <a href="https://www.youtube.com/@stlouisfrancais" target="_blank" rel="noopener noreferrer">YouTube</a>, 
            notre compte <a href="https://www.instagram.com/saint_louis_des_francais/" target="_blank" rel="noopener noreferrer">Instagram</a> 
            et Facebook.
          </p>
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/BpgVML6todQ"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <section class="section" id="fr-8">
        <div class="container reveal">
          <span class="eyebrow">8. JUMELAGE SOLIDAIRE</span>
          <h2 class="section-title">Jumelage solidaire avec le Liban (3%)</h2>
          <p>
            En soutenant notre projet, vous pensez aussi à ceux dans le besoin : par le biais de 
            l'Œuvre d'Orient, <strong>3% de l'argent récolté</strong> soutiendra les chrétiens du Liban.
          </p>
        </div>
      </section>

      <section class="section" id="fr-9">
        <div class="container reveal">
          <span class="eyebrow">9. NOS RESSOURCES</span>
          <h2 class="section-title">Nos ressources et nos besoins</h2>
          <p class="liturgie-intro">
            Disponibilité actuelle : <strong>2.470.000€</strong> (gestión de l'Œuvre + grand donateur + emprunt sans intérêts).
          </p>
          <div class="recursos-grid">
            <div class="recurso-card">
              <span class="don-label">Coût total</span>
              <span class="don-amount">3 500 000 €</span>
            </div>
            <div class="recurso-card">
              <span class="don-label">Disponible</span>
              <span class="don-amount recurso-ok">2 470 000 €</span>
            </div>
            <div class="recurso-card">
              <span class="don-label">À lever fin 2026</span>
              <span class="don-amount recurso-needed">1 000 000 €</span>
            </div>
          </div>
          <p class="liturgie-intro" style="margin-top:1.5rem;">
            500.000€ par levée de fonds · 500.000€ par grands donateurs
          </p>
        </div>
      </section>

      <section class="section" id="fr-10">
        <div class="container reveal">
          <span class="eyebrow">10. RÉSULTATS DE LA CAMPAGNE</span>
          <h2 class="section-title">Résultats de la campagne</h2>
          <p class="liturgie-note">À compléter en fonction de l'avancement de la campagne.</p>
        </div>
      </section>

    </div>

    <!-- ===== CONTENIDO ES ===== -->
    <div id="content-es" style="display:none;">

      <section class="section" id="es-1">
        <div class="container reveal">
          <span class="eyebrow">1. QUIERO DONAR</span>
          <h2 class="section-title">Quiero donar</h2>
          <p class="liturgie-intro">
            Apoya el proyecto de la parroquia de cualquiera de estas maneras.<br/>
            ⚠️ Consulta las ventajas fiscales en el punto 3 para ayudarnos mejor.
          </p>
          <div class="renovation-bizum">
            <span class="don-label">Bizum solidario – código : 13902</span>
            <span class="bizum-code">13902</span>
            <p>En la app de Bizum, elige «Donar a una ONG» e introduce el código <strong>13902</strong>.</p>
          </div>
          <div class="don-grid">
            <div class="don-card">
              <span class="don-label">Transferencia bancaria</span>
              <span class="don-iban">ES98 0049 6791 7629 1601 6891</span>
              <span class="don-note">BIC : BSCHESMM</span>
            </div>
            <div class="don-card">
              <span class="don-label">Tarjeta bancaria</span>
              <span class="don-note">Enlace en preparación. ⚠️ Se aplica comisión.</span>
            </div>
          </div>
          <p class="don-contact">
            Contacto: <a href="mailto:paroissesaintlouismadrid@gmail.com">paroissesaintlouismadrid@gmail.com</a>
          </p>
        </div>
      </section>

      <section class="section" id="es-2">
        <div class="container reveal">
          <span class="eyebrow">2. OTROS MEDIOS PARA AYUDAR</span>
          <h2 class="section-title">Otros medios para ayudar</h2>
          <p>
            Pensad en todas las personas que estarán felices de participar: familia, amigos, padrinos, 
            madrinas, etc. Esta multitud de pequeñas ayudas puede marcar la diferencia.
          </p>
          <p>
            También buscamos <strong>grandes donantes</strong>. Contactad con el padre Rodrigo 
            para organizar una presentación personalizada.
          </p>
          <p>¡Compartid el enlace de esta página y los vídeos!</p>
        </div>
      </section>

      <section class="section" id="es-3">
        <div class="container reveal">
          <span class="eyebrow">3. VENTAJAS FISCALES</span>
          <h2 class="section-title">Ventajas fiscales</h2>
          <h3 class="renovation-subtitle">Si está sujeto a impuestos en España:</h3>
          <p class="liturgie-intro">
            <strong>80%</strong> de deducción sobre los primeros <strong>250€</strong> y 
            <strong>40%</strong> sobre el resto (<strong>45%</strong> si se repite 3 años).
          </p>
          <div class="fiscal-grid">
            <div class="fiscal-card">
              <span class="fiscal-don">Donación 500 €</span>
              <span class="fiscal-coste">Coste real <strong>200 €</strong></span>
              <span class="fiscal-reduccion">Reducción 300 €</span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Donación 1 000 €</span>
              <span class="fiscal-coste">Coste real <strong>500 €</strong></span>
              <span class="fiscal-reduccion">Reducción 500 €</span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Donación 2 000 €</span>
              <span class="fiscal-coste">Coste real <strong>1 100 €</strong></span>
              <span class="fiscal-reduccion">Reducción 900 €</span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Donación 3 000 €</span>
              <span class="fiscal-coste">Coste real <strong>1 700 €</strong></span>
              <span class="fiscal-reduccion">Reducción 1 300 €</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="es-4">
        <div class="container reveal">
          <span class="eyebrow">4. UN LUGAR EMBLEMÁTICO</span>
          <h2 class="section-title">Saint-Louis-des-Français, un lugar emblemático</h2>
          <p>
            Durante más de 400 años, en el corazón de Madrid, la parroquia ha sido un referente 
            para miles de familias francófonas. Un lugar de fe, un espacio de encuentro, un puente 
            entre culturas.
          </p>
          <p>Apoyar este proyecto significa preservar un patrimonio vivo y transmitir una historia.</p>
        </div>
      </section>

      <section class="section" id="es-5">
        <div class="container reveal">
          <span class="eyebrow">5. ¿POR QUÉ ESTAS OBRAS?</span>
          <h2 class="section-title">¿Por qué estas obras?</h2>
          <p>
            La iglesia requiere una renovación para cumplir normas de seguridad, medioambientales 
            y adaptar los espacios. Van a embellecer la iglesia con una catequesis pictórica y una 
            estatua-relicario de San Luis.
          </p>
        </div>
      </section>

      <section class="section" id="es-6">
        <div class="container reveal">
          <span class="eyebrow">6. PROYECTO DETALLADO</span>
          <h2 class="section-title">Proyecto detallado</h2>
          <h3 class="renovation-subtitle">Renovación de la iglesia:</h3>
          <div class="renovation-lista">
            <span>Aislamiento térmico completo</span>
            <span>Climatización mediante aerotermia</span>
            <span>Nuevo falso techo con seguridad contra incendios</span>
            <span>Decoración artística y catequética</span>
            <span>Iluminación profesional</span>
            <span>Mejora acústica</span>
            <span>Nuevos bancos con reclinatorios</span>
            <span>Sacristía renovada</span>
            <span>Cableado para retransmisiones</span>
            <span>Sistemas de seguridad</span>
            <span>Renovación del órgano</span>
            <span>Creación de un columbario</span>
            <span>Estatua de San Luis con relicario</span>
          </div>
          <h3 class="renovation-subtitle">Espacios parroquiales:</h3>
          <div class="renovation-lista">
            <span>Salas modulables</span>
            <span>Vestíbulo hacia la Sala Saureulx</span>
            <span>Gran sala renovada</span>
            <span>Cocina y bar funcionales</span>
            <span>Estudio de contenidos</span>
            <span>Nuevos baños accesibles</span>
            <span>Wifi y equipamiento</span>
            <span>Espacios de almacenamiento</span>
          </div>
          <h3 class="renovation-subtitle">Pasarela de acceso ♿:</h3>
          <p>Pasarela accesible entre la iglesia y la residencia Saint-Louis.</p>
          <h3 class="renovation-subtitle">Un fresco en el corazón de la oración:</h3>
          <p>Gran fresco de la historia de la Salvación.</p>
        </div>
      </section>

      <section class="section" id="es-7">
        <div class="container reveal">
          <span class="eyebrow">7. PROYECTO EN IMÁGENES Y VÍDEOS 🎥</span>
          <h2 class="section-title">Proyecto en imágenes y vídeos</h2>
          <p class="liturgie-intro">
            Descubre nuestro proyecto en 
            <a href="https://www.youtube.com/@stlouisfrancais" target="_blank" rel="noopener noreferrer">YouTube</a>, 
            <a href="https://www.instagram.com/saint_louis_des_francais/" target="_blank" rel="noopener noreferrer">Instagram</a> 
            y Facebook.
          </p>
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/BpgVML6todQ"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <section class="section" id="es-8">
        <div class="container reveal">
          <span class="eyebrow">8. HERMANAMIENTO SOLIDARIO</span>
          <h2 class="section-title">Hermanamiento solidario con Líbano (3%)</h2>
          <p>
            El <strong>3% de los fondos recaudados</strong> se destinará a apoyar a los cristianos 
            del Líbano mediante la Œuvre d'Orient.
          </p>
        </div>
      </section>

      <section class="section" id="es-9">
        <div class="container reveal">
          <span class="eyebrow">9. NUESTROS RECURSOS</span>
          <h2 class="section-title">Recursos y necesidades</h2>
          <p class="liturgie-intro">
            Disponibilidad actual: <strong>2.470.000€</strong>.
          </p>
