    current = (current - 1 + grupoActual.length) % grupoActual.length;
    updateLightbox();
  });
  document.getElementById('fresqueNext').addEventListener('click', function() {
    current = (current + 1) % grupoActual.length;
    updateLightbox();
  });
  document.addEventListener('keydown', function(e) {
    if (!document.getElementById('fresqueLightbox').classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') { current = (current - 1 + grupoActual.length) % grupoActual.length; updateLightbox(); }
    if (e.key === 'ArrowRight') { current = (current + 1) % grupoActual.length; updateLightbox(); }
  });
  document.getElementById('fresqueLightbox').addEventListener('click', function(e) {
    if (e.target === this) closeLightbox();
  });
})();

