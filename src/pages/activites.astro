---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import activitesDataRaw from "../data/activites/activites.json";

const activitesData = activitesDataRaw as {
  enfants: { titre: string; age?: string; texto: string; contacto_nombre?: string; contacto_telefono?: string; texto_final?: string; enlace_texto?: string; enlace_url?: string }[];
  jeunes: any[];
  adultes: { titre: string; age?: string; texto: string; contacto_nombre?: string; contacto_telefono?: string; texto_final?: string; enlace_texto?: string; enlace_url?: string }[];
  liturgie_service: { titre: string; texto: string; contacto_nombre?: string; contacto_telefono?: string; contacto_email?: string; texto_final?: string }[];
  calendrier: { titre: string; texto: string; pdf_url: string; boton_texto: string };
};
---

<BaseLayout title="Activités — Saint Louis des Français">
  <Header />

  <main>

    <!-- PAGE HEADER -->
    <div class="page-header">
      <div class="container">
        <span class="eyebrow">VIE PAROISSIALE</span>
        <h1>Activités</h1>
        <p>Une communauté vivante pour chaque tranche d'âge.</p>
      </div>
    </div>

    <!-- ENFANTS -->
    <section class="section" id="enfants">
      <div class="container">
        <div class="activites-header reveal">
          <span class="eyebrow">ENFANTS</span>
          <h2 class="section-title">Pour les plus jeunes</h2>
        </div>
        <div class="activites-list">
          {activitesData.enfants.map((act) => (
            <div class="activite-item reveal">
              <div class="activite-meta">
                <span class="activite-titre">{act.titre}</span>
                {act.age && <span class="activite-age">{act.age}</span>}
              </div>
              <div>
                <p>{act.texto}
                  {act.contacto_nombre && (
                    <>
                      <br />
                      <a class="activite-link">Contact pour s'inscrire : {act.contacto_nombre} {act.contacto_telefono}</a>
                    </>
                  )}
                  {act.texto_final && (
                    <>
                      <br /> {act.texto_final}
                    </>
                  )}
                </p>
                {act.enlace_url && (
                  <a href={act.enlace_url} target="_blank" rel="noopener noreferrer" class="activite-link">{act.enlace_texto}</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- JEUNES -->
    <section class="section" id="jeunes">
      <div class="container">
        <div class="activites-header reveal">
          <span class="eyebrow">JEUNES</span>
          <h2 class="section-title">Pour les adolescents et jeunes adultes</h2>
        </div>
        <div class="activites-list">
          {activitesData.jeunes.map((act) => (
            act.grupos ? (
              <div class="activite-item reveal">
                <div class="activite-meta">
                  <span class="activite-titre">{act.titre}</span>
                  <span class="activite-age">{act.age}</span>
                </div>
                <div>
                  {act.grupos.map((grupo: any) => (
                    <p>
                      <strong>{grupo.nombre}</strong> — {grupo.texto}
                      {grupo.enlace_url && (
                        <a href={grupo.enlace_url} target="_blank" rel="noopener noreferrer" class="activite-link"> {grupo.enlace_texto}</a>
                      )}
                    </p>
                  ))}
                </div>
              </div>
            ) : (
              <div class="activite-item reveal">
                <div class="activite-meta">
                  <span class="activite-titre">{act.titre}</span>
                  {act.age && <span class="activite-age">{act.age}</span>}
                </div>
                <div>
                  <p>{act.texto}
                    {act.contacto_email && (
                      <a href={`mailto:${act.contacto_email}`} class="activite-link"> {act.contacto_email}</a>
                    )}
                  </p>
                  {act.texto_final && <p>{act.texto_final}</p>}
                  {act.enlace_url && (
                    <a href={act.enlace_url} target="_blank" rel="noopener noreferrer" class="activite-link">{act.enlace_texto}</a>
                  )}
                </div>
              </div>
            )
          ))}
        </div>
      </div>
    </section>

    <!-- ADULTES -->
    <section class="section" id="adultes">
      <div class="container">
        <div class="activites-header reveal">
          <span class="eyebrow">ADULTES ET FAMILLES</span>
          <h2 class="section-title">Pour les adultes et les couples</h2>
        </div>
        <div class="activites-list">
          {activitesData.adultes.map((act) => (
            <div class="activite-item reveal">
              <div class="activite-meta">
                <span class="activite-titre">{act.titre}</span>
                {act.age && <span class="activite-age">{act.age}</span>}
              </div>
              <div>
                <p>{act.texto}</p>
                {act.contacto_nombre && (
                  <p>Responsables : {act.contacto_nombre} : {act.contacto_telefono}</p>
                )}
                {act.texto_final && <p>{act.texto_final}</p>}
                {act.enlace_url && (
                  <a href={act.enlace_url} target="_blank" rel="noopener noreferrer" class="activite-link">{act.enlace_texto}</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- LITURGIE -->
    <section class="section" id="liturgie">
      <div class="container">
        <div class="activites-header reveal">
          <span class="eyebrow">LITURGIE ET SERVICE</span>
          <h2 class="section-title">Participer à la vie liturgique</h2>
        </div>
        <div class="activites-list">
          {activitesData.liturgie_service.map((act) => (
            <div class="activite-item reveal">
              <div class="activite-meta">
                <span class="activite-titre">{act.titre}</span>
              </div>
              <p>{act.texto}
                {act.contacto_nombre && ` ${act.contacto_nombre}`}
                {act.contacto_email && (
                  <> · <a href={`mailto:${act.contacto_email}`}>{act.contacto_email}</a></>
                )}
                {act.contacto_telefono && ` ou ${act.contacto_telefono}`}
              </p><br>
              {act.texto_final && <p>{act.texto_final}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CALENDRIER -->
    <section class="section">
      <div class="container reveal">
        <span class="eyebrow">CALENDRIER</span>
        <h2 class="section-title">{activitesData.calendrier.titre}</h2>
        <p class="liturgie-intro">{activitesData.calendrier.texto}</p>
        <a href={activitesData.calendrier.pdf_url}
           target="_blank" rel="noopener noreferrer" class="cta-button">
          {activitesData.calendrier.boton_texto}
        </a>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="cta reveal">
      <div class="container cta-inner">
        <div class="cta-text">
          <h2>Vous souhaitez vous impliquer ?</h2>
          <p>Contactez-nous pour rejoindre l'une de nos activités.</p>
        </div>
        <a href="/contact" class="cta-button">Nous contacter</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>