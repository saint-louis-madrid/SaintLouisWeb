---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Activités — Saint Louis des Français">
  <Header />

  <main>

    <!-- PAGE HEADER -->
    <div class="page-header">
      <div class="container">
        <span class="eyebrow">VIE PAROISSIALE</span>
        <h1>Activités</h1>
        <p>Une communauté vivante pour chaque tranche d'âge.</p>
      </div>
    </div>

    <!-- ENFANTS -->
    <section class="section" id="enfants">
      <div class="container">
        <div class="activites-header reveal">
          <span class="eyebrow">ENFANTS</span>
          <h2 class="section-title">Pour les plus jeunes</h2>
        </div>
        <div class="activites-list">
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Éveil à la foi</span>
              <span class="activite-age">6 – 8 ans</span>
            </div>
            <p>Première découverte de la foi chrétienne dans un cadre ludique et bienveillant.</p>
          </div>
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Catéchisme</span>
              <span class="activite-age">8 – 11 ans</span>
            </div>
            <div>
              <p>Dispensé dans les installations de la paroisse et au LFM. 4 années de catéchisme : KT1 à KT4. Coordination : Inmaculada Paredes et Yolanda Ella · +34 6 86 10 56 03</p>
              <a href="https://docs.google.com/forms/d/e/1FAIpQLSdt6RUrVRzWSVuogVac9iefMdj_962oAF5tJua24vsILzEl1g/viewform" target="_blank" rel="noopener noreferrer" class="activite-link">S'inscrire →</a>
            </div>
          </div>
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Enfants de chœur</span>
              <span class="activite-age">Tous âges</span>
            </div>
            <p>Participation active à la liturgie comme enfant de chœur ou servante d'assemblée.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- JEUNES -->
    <section class="section" id="jeunes">
      <div class="container">
        <div class="activites-header reveal">
          <span class="eyebrow">JEUNES</span>
          <h2 class="section-title">Pour les adolescents et jeunes adultes</h2>
        </div>
        <div class="activites-list">
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Scouts francophones</span>
              <span class="activite-age">8 – 17 ans</span>
            </div>
            <div>
              <p>Groupe Saint Louis – 1ère Madrid, rattaché à la paroisse. Pédagogie des Scouts Unitaires de France (SUF). En jouant, en vivant au contact de la nature, en prenant progressivement des responsabilités et en vivant une foi tonique !</p>
              <p>Devise : « Faire de son mieux ! »</p>
              <a href="mailto:groupescoutsaintlouismadrid@gmail.com" class="activite-link">groupescoutsaintlouismadrid@gmail.com</a>
            </div>
          </div>
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Aumônerie</span>
              <span class="activite-age">6ème – Terminale</span>
            </div>
            <div>
              <p><strong>6è-5è</strong> — Accompagnement vers la profession de foi avec le père Rodrigo et des jeunes étudiants. <a href="https://docs.google.com/forms/d/e/1FAIpQLScB3M9kJYAdRYc5DEEydUYWGbzZnBuoReRXTQgXZ09X9XBGsA/viewform" target="_blank" rel="noopener noreferrer" class="activite-link">S'inscrire →</a></p>
              <p><strong>4è-3è-2nde</strong> — Parcours Lifeteen le dimanche à 17h30 jusqu'à la messe de 19h. Préparation à la confirmation. Contact : Clara de Biennassis · +34 6 15 57 78 08</p>
              <p><strong>1ère-Terminale</strong> — Approfondissement de la foi et service. Contact : Jean-Michel Béranger · +34 699 419 975</p>
              <p><strong>Initiation chrétienne adultes</strong> — Pour les non-baptisés ou souhaitant recevoir baptême, confirmation ou première communion. Contacter le père Rodrigo.</p>
            </div>
          </div>
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Étudiants & Jeunes professionnels</span>
            </div>
            <div>
              <p><strong>Étudiants</strong> — Retrouvez-vous le mercredi soir à 20h à la paroisse pour la messe, puis des soirées d'échanges et de prières autour d'un apéro.</p>
              <p><strong>Jeunes professionnels</strong> — Réunions le jeudi soir une semaine sur deux à 19h45. Débat et dîner sur une thématique alliant foi et actualité.</p>
              <p>Contact : Victoire · +33 6 51 33 51 44 · Marine · +33 6 50 31 23 94</p>
            </div>
          </div>
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Foyer des jeunes</span>
              <span class="activite-age">Étudiants & jeunes pros</span>
            </div>
            <div>
              <p>Espace de vie et de mission pour les étudiants catholiques à Madrid. Logement à prix réduit et engagement pastoral.</p>
              <a href="/foyer" class="activite-link">En savoir plus →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ADULTES -->
    <section class="section" id="adultes">
      <div class="container">
        <div class="activites-header reveal">
          <span class="eyebrow">ADULTES ET FAMILLES</span>
          <h2 class="section-title">Pour les adultes et les couples</h2>
        </div>
        <div class="activites-list">
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Équipes Notre-Dame</span>
              <span class="activite-age">Couples</span>
            </div>
            <div>
              <p>Cheminement en équipes de 4 à 5 couples unis par le sacrement de mariage. Chaque mois, réunion avec un prêtre pour prier, partager et approfondir la foi en couple.</p>
              <p>Contact : Isabelle Moutaux · +33 6 61 57 63 12</p>
              <a href="https://www.equipes-notre-dame.fr" target="_blank" rel="noopener noreferrer" class="activite-link">www.equipes-notre-dame.fr →</a>
            </div>
          </div>
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Préparation au mariage</span>
              <span class="activite-age">Futurs époux</span>
            </div>
            <div>
              <p>Les couples s'adressent au père Rodrigo à la sortie de la messe dominicale de 11h30 ou 19h. Un chemin de préparation sera proposé avec l'accompagnement de Benoît et Viviane Mahé.</p>
              <p>Anne Gras, au secrétariat, accompagnera les futurs époux pour la constitution du dossier canonique.</p>
            </div>
          </div>
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Préparation au baptême</span>
              <span class="activite-age">Familles</span>
            </div>
            <p>Se présenter au père Rodrigo à la sortie de la messe dominicale pour toute demande de baptême d'enfant ou d'adulte.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- LITURGIE -->
    <section class="section" id="liturgie">
      <div class="container">
        <div class="activites-header reveal">
          <span class="eyebrow">LITURGIE ET SERVICE</span>
          <h2 class="section-title">Participer à la vie liturgique</h2>
        </div>
        <div class="activites-list">
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Animation liturgique</span>
            </div>
            <p>Chants et instruments pour accompagner les célébrations. Ouvert à tous les musiciens et chanteurs.</p>
          </div>
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Lectures et prière universelle</span>
            </div>
            <p>Participation active à la liturgie comme lecteur ou pour la prière universelle.</p>
          </div>
          <div class="activite-item reveal">
            <div class="activite-meta">
              <span class="activite-titre">Bibliothèque française</span>
            </div>
            <p>Bibliothèque paroissiale en français, ouverte à toute la communauté.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CALENDRIER -->
    <section class="section">
      <div class="container reveal">
        <span class="eyebrow">CALENDRIER</span>
        <h2 class="section-title">Calendrier 2025-2026</h2>
        <p class="liturgie-intro">
          Retrouvez le calendrier complet des activités du catéchisme,
          de l'aumônerie et des jeunes professionnels pour l'année scolaire 2025-2026.
        </p>
        <a href="http://sanluisfranceses.archimadrid.com/wp-content/uploads/2025/10/Calendrier-Annuel-Paroisse-St-Louis-des-francais.pdf"
           target="_blank" rel="noopener noreferrer" class="cta-button">
          Télécharger le calendrier PDF
        </a>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="cta reveal">
      <div class="container cta-inner">
        <div class="cta-text">
          <h2>Vous souhaitez vous impliquer ?</h2>
          <p>Contactez-nous pour rejoindre l'une de nos activités.</p>
        </div>
        <a href="/contact" class="cta-button">Nous contacter</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>