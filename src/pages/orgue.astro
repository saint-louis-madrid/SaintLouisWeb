            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Claviers et console</span>
              <span class="fiscal-coste"><strong>35 000 €</strong></span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Mécanique</span>
              <span class="fiscal-coste"><strong>70 000 €</strong></span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Sommiers</span>
              <span class="fiscal-coste"><strong>60 000 €</strong></span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Tuyauterie</span>
              <span class="fiscal-coste"><strong>120 000 €</strong></span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Buffet</span>
              <span class="fiscal-coste"><strong>25 000 €</strong></span>
            </div>
            <div class="fiscal-card">
              <span class="fiscal-don">Harmonisation finale</span>
              <span class="fiscal-coste"><strong>19 600 €</strong></span>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="fr-5">
        <div class="container reveal">
          <span class="eyebrow">5. POURQUOI SOUTENIR CE PROJET</span>
          <h2 class="section-title">Pourquoi soutenir ce projet</h2>

          <h3 class="renovation-subtitle">🌍 Un engagement RSE concret</h3>
          <div class="renovation-lista">
            <span>Préservation d'un patrimoine culturel européen</span>
            <span>Contribution à la vie culturelle madrilène</span>
            <span>Projet durable et intergénérationnel</span>
          </div>
<h3 class="renovation-subtitle">
  <svg width="20" height="14" viewBox="0 0 20 14" style="margin-right:4px; vertical-align:middle;">
