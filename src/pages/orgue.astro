<BaseLayout title="Orgue Cavaillé-Coll — Saint Louis des Français">
  <Header />

  <main>

    <!-- HERO -->
    <div class="page-header">
      <div class="container">
        <span class="eyebrow">PATRIMOINE MUSICAL · PATRIMONIO MUSICAL</span>
        <h1>Orgue Cavaillé-Coll</h1>
        <p>Le plus ancien orgue Cavaillé-Coll conservé à Madrid · El órgano Cavaillé-Coll más antiguo conservado en Madrid</p>
      </div>
    </div>

    <!-- SELECTOR DE IDIOMA -->
    <div class="lang-selector-bar">
      <div class="container">
        <button class="lang-selector-btn active" id="btnFR-orgue"> <svg width="20" height="14" viewBox="0 0 20 14" style="margin-right:4px; vertical-align:middle;">
    <rect width="7" height="14" fill="#002395"/>
    <rect x="7" width="6" height="14" fill="#fff"/>
    <rect x="13" width="7" height="14" fill="#ED2939"/>
  </svg>
          Français</button>
        <button class="lang-selector-btn" id="btnES-orgue"> 
