<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {

    // Selector idioma
    var btnFR = document.getElementById('btnFR-orgue');
    var btnES = document.getElementById('btnES-orgue');

    if (btnFR) btnFR.addEventListener('click', function() { setLangOrgue('fr'); });
    if (btnES) btnES.addEventListener('click', function() { setLangOrgue('es'); });

    function setLangOrgue(lang) {
      var fr = document.getElementById('content-fr-orgue');
      var es = document.getElementById('content-es-orgue');
      var iFR = document.getElementById('indexFR-orgue');
      var iES = document.getElementById('indexES-orgue');
      if (fr) fr.style.display = lang === 'fr' ? 'block' : 'none';
      if (es) es.style.display = lang === 'es' ? 'block' : 'none';
      if (btnFR) btnFR.classList.toggle('active', lang === 'fr');
      if (btnES) btnES.classList.toggle('active', lang === 'es');
      if (iFR) iFR.style.display = lang === 'fr' ? 'flex' : 'none';
      if (iES) iES.style.display = lang === 'es' ? 'flex' : 'none';
    }

    // Modal PDF
var modal = document.getElementById('pdfModal');
var frame = document.getElementById('pdfFrame');
var closeBtn = document.getElementById('btnCloseModal');

var docs = {
  btnModalFR:       'https://drive.google.com/file/d/1nETWqQZTGXH7FXtAHdnpLwF1KHXSX50a/preview',
  btnModalES:       'https://drive.google.com/file/d/1nETWqQZTGXH7FXtAHdnpLwF1KHXSX50a/preview',
  btnModalMarsaultFR: 'https://drive.google.com/file/d/1VuBNnAH7lAjbdkht2V97jHhpZbzZs2a3/preview',
  btnModalMarsaultES: 'https://drive.google.com/file/d/1VuBNnAH7lAjbdkht2V97jHhpZbzZs2a3/preview',
  btnModalOspitalFR:  'https://drive.google.com/file/d/14jHiR3cF-MkzXWPJ9GKOQqnCImnFTJ0d/preview',
  btnModalOspitalES:  'https://drive.google.com/file/d/14jHiR3cF-MkzXWPJ9GKOQqnCImnFTJ0d/preview',
  btnModalTheseFR:    'https://drive.google.com/file/d/15evLJE5wl5BPnJ62eF_wid-iiZUun5cL/preview',
  btnModalTheseES:    'https://drive.google.com/file/d/15evLJE5wl5BPnJ62eF_wid-iiZUun5cL/preview',
};

Object.keys(docs).forEach(function(id) {
  var btn = document.getElementById(id);
  if (btn) btn.addEventListener('click', function() {
    if (frame) frame.src = docs[id];
    if (modal) { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
  });
});

function closeModal() {
  if (modal) { modal.style.display = 'none'; document.body.style.overflow = ''; }
  if (frame) frame.src = '';
}

if (closeBtn) closeBtn.addEventListener('click', closeModal);
if (modal) modal.addEventListener('click', function(e) {
  if (e.target === modal) closeModal();
});

    // Back to top
    var backToTop = document.getElementById('backToTop');
    if (backToTop) {
      window.addEventListener('scroll', function() {
        backToTop.classList.toggle('visible', window.scrollY > 400);
      });
    }

  });
</script>
