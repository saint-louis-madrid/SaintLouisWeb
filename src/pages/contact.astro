---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import contactDataRaw from "../data/contact/contact.json";

const contactData = contactDataRaw as {
  info_practica: {
    direccion: string[];
    metro: string[];
    email: string;
    messes: string[];
    pere_rodrigo: string[];
  };
  whatsapp: { numero_display: string; numero_url: string; texto: string };
  newsletter_url: string;
};

const waBase = contactData.whatsapp.numero_url;
const waSubscribeUrl =
  waBase +
  (waBase.includes("?") ? "&" : "?") +
  "text=" +
  encodeURIComponent("Bonjour, je souhaite recevoir les informations paroissiales. Mon nom : ");

---

<BaseLayout title="Contact — Saint Louis des Français">
  <Header />

  <main>
    <div class="page-header">
      <div class="container">
        <span class="eyebrow">CONTACT</span>
        <h1>Nous contacter</h1>
        <p>Une question, une demande de sacrement ou simplement nous rejoindre ?</p>
      </div>
    </div>

    <!-- CONTENU -->
    <section class="section">
      <div class="container contact-grid">

        <!-- FORMULAIRE -->
        <div class="reveal">
          <h2 class="contact-title">Envoyer un message</h2>
          <form class="contact-form" id="contact-form">
            
            <!-- Campo Honeypot para anti-spam (oculto a usuarios reales) -->
            <div style="display: none !important;" aria-hidden="true">
              <label for="honeypot">Ne pas remplir ce champ</label>
              <input type="text" id="honeypot" name="honeypot" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-group">
              <label for="name">Nom complet</label>
              <input type="text" id="name" name="name" placeholder="Marie Dupont" required minlength="2" maxlength="80" />
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="marie@exemple.com" required />
            </div>

            <div class="form-group">
              <label for="subject">Sujet</label>
              <select id="subject" name="subject" required>
                <option value="">Choisir un sujet</option>
                <option value="Renseignement général">Renseignement général</option>
                <option value="Baptême">Baptême</option>
                <option value="Mariage">Mariage</option>
                <option value="Catéchisme">Catéchisme</option>
                <option value="Projet Rénovation">Projet Rénovation</option>
                <option value="Autre">Autre</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" placeholder="Votre message..." required minlength="10" maxlength="2000"></textarea>
            </div>

            <div class="form-group">
              <label class="form-checkbox">
                <input type="checkbox" name="consent" required />
                <span>
                  J'accepte que mes données soient utilisées pour répondre à ma demande, 
                  conformément à la 
                  <a href="/privacy" target="_blank" rel="noopener noreferrer"> politique de confidentialité</a>.
                </span>
              </label>
            </div>

            <button type="submit" id="btn-submit" class="form-submit">Envoyer le message</button>
            <p class="form-notice" id="form-notice">Vos données sont traitées conformément à notre <a href="/privacy">politique de confidentialité</a>.</p>
          </form>
        </div>

        <!-- INFO PRATIQUE -->
        <div class="contact-info reveal">
          <h2 class="contact-title">Informations pratiques</h2>

          <div class="info-block">
            <span class="info-label">Adresse</span>
            {contactData.info_practica.direccion.map((linea) => <span>{linea}</span>)}
          </div>

          <div class="info-block">
            <span class="info-label">Métro</span>
            {contactData.info_practica.metro.map((linea) => <span>{linea}</span>)}
          </div>

          <div class="info-block">
            <span class="info-label">Email</span>
            <a href={`mailto:${contactData.info_practica.email}`}>
              {contactData.info_practica.email}
            </a>
          </div>

          <div class="info-block">
            <span class="info-label">Messes en français</span>
            {contactData.info_practica.messes.map((linea) => <span>{linea}</span>)}
          </div>

          <div class="info-block">
            <span class="info-label">Père Rodrigo</span>
            {contactData.info_practica.pere_rodrigo.map((linea) => <span>{linea}</span>)}
          </div>

         
            <div class="info-block">
            <span class="info-label">WhatsApp</span>
            <a href={contactData.whatsapp.numero_url} target="_blank" rel="noopener noreferrer">
              {contactData.whatsapp.numero_display}
            </a>
            <span>{contactData.whatsapp.texto}</span>
            <button type="button" class="wa-open-btn" id="wa-open">
              📲 Recevoir les actualités par WhatsApp
            </button>
          </div>
          

        </div>

      </div>
    </section>
<dialog class="wa-dialog" id="wa-dialog" aria-labelledby="wa-title">
  <button type="button" class="wa-close" id="wa-close" aria-label="Fermer">✕</button>

  <h2 id="wa-title">Recevoir les actualités de la paroisse par WhatsApp</h2>
  <p><strong>Vous souhaitez être informé des actualités, événements et annonces de la paroisse ?</strong></p>
  <p>Nous vous proposons de vous inscrire à notre liste de diffusion WhatsApp afin de recevoir directement sur votre téléphone les informations paroissiales.</p>

  <h3>Comment s'inscrire ?</h3>
  <ol>
    <li>Cliquez sur le bouton WhatsApp ci-dessous pour ouvrir une conversation avec la paroisse.</li>
    <li>Envoyez-nous un petit message en indiquant votre nom et que vous souhaitez recevoir les informations paroissiales.</li>
    <li>Nous vous ajouterons à notre liste de diffusion.</li>
  </ol>

  <a href={waSubscribeUrl} target="_blank" rel="noopener noreferrer" class="cta-button wa-btn">
    S'inscrire par WhatsApp
  </a>

  <div class="wa-note">
    <strong>Important :</strong> pour recevoir nos messages, pensez à enregistrer le numéro de téléphone de la paroisse dans vos contacts. Sans cela, WhatsApp ne vous transmettra pas les messages de diffusion.
  </div>

  <p class="wa-small">Il ne s'agit pas d'un groupe WhatsApp : vous recevrez les informations directement dans votre conversation avec la paroisse, sans être ajouté à un groupe ni recevoir les réponses des autres abonnés.</p>
</dialog>
  </main>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
    const notice = document.getElementById('form-notice') as HTMLParagraphElement;

    const API_URL = import.meta.env.PUBLIC_API_URL
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      btnSubmit.disabled = true;
      btnSubmit.textContent = 'Envoi en cours...';

      const fd = new FormData(form);
      const payload = {
        nombre:   fd.get('name')?.toString().trim(),
        email:    fd.get('email')?.toString().trim(),
        asunto:   fd.get('subject')?.toString().trim(),
        mensaje:  fd.get('message')?.toString().trim(),
        honeypot: fd.get('honeypot')?.toString() || null,
      };

      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.status === 201) {
          form.reset();
          if (notice) {
            notice.style.color = '#155724';
            notice.textContent = 'Message envoyé avec succès. Merci !';
          }
        } else if (res.status === 429) {
          if (notice) {
            notice.style.color = '#721c24';
            notice.textContent = 'Trop de tentatives. Veuillez patienter 5 minutes.';
          }
        } else {
          if (notice) {
            notice.style.color = '#721c24';
            notice.textContent = 'Erreur lors de l\'envoi. Veuillez réessayer.';
          }
        }
      } catch (err) {
        if (notice) {
          notice.style.color = '#721c24';
          notice.textContent = 'Impossible de contacter le serveur. Vérifiez votre connexion.';
        }
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.textContent = 'Envoyer le message';
      }
    });

    const waDialog = document.getElementById('wa-dialog') as HTMLDialogElement | null;

function openWa() {
  if (!waDialog || waDialog.open) return;
  waDialog.showModal();
  document.body.style.overflow = 'hidden';
}

document.getElementById('wa-open')?.addEventListener('click', openWa);
document.getElementById('wa-close')?.addEventListener('click', () => waDialog?.close());

// Cerrar al hacer clic fuera del cuadro
waDialog?.addEventListener('click', (e) => {
  if (e.target === waDialog) waDialog.close();
});

// Restaurar el scroll al cerrar (botón, Esc o clic fuera)
waDialog?.addEventListener('close', () => {
  document.body.style.overflow = '';
});

// Permite abrirlo directamente con /contact#whatsapp
if (location.hash === '#whatsapp') openWa();
  </script>

  <Footer />
</BaseLayout>