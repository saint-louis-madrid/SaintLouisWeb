---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import contactDataRaw from "../data/contact/contact.json";

const contactData = contactDataRaw as {
  info_practica: {
    direccion: string[];
    metro: string[];
    email: string;
    messes: string[];
    pere_rodrigo: string[];
  };
  whatsapp: { numero_display: string; numero_url: string; texto: string };
  newsletter_url: string;
};
---

<BaseLayout title="Contact — Saint Louis des Français">
  <Header />

  <main>

    <div class="page-header">
  <div class="container">
    <span class="eyebrow">CONTACT</span>
    <h1>Nous contacter</h1>
    <p>Une question, une demande de sacrement ou simplement nous rejoindre ?</p>
  </div>
</div>

    <!-- CONTENU -->
    <section class="section">
      <div class="container contact-grid">

        <!-- FORMULAIRE -->
        <div class="reveal">
          <h2 class="contact-title">Envoyer un message</h2>
          <form class="contact-form" id="contact-form">
            <div class="form-group">
              <label for="name">Nom complet</label>
              <input type="text" id="name" name="name" placeholder="Marie Dupont" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="marie@exemple.com" required />
            </div>
            <div class="form-group">
              <label for="subject">Sujet</label>
              <select id="subject" name="subject" required>
                <option value="">Choisir un sujet</option>
                <option value="information">Renseignement général</option>
                <option value="bapteme">Baptême</option>
                <option value="mariage">Mariage</option>
                <option value="catechisme">Catéchisme</option>
                <option value="renovation">Projet Rénovation</option>
                <option value="autre">Autre</option>
              </select>
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" placeholder="Votre message..." required></textarea>
            </div>
            <div class="form-group">
  <label class="form-checkbox">
    <input type="checkbox" name="consent" required />
    <span>
      J'accepte que mes données soient utilisées pour répondre à ma demande, 
      conformément à la 
      <a href="/privacy" target="_blank" rel="noopener noreferrer">politique de confidentialité</a>.
    </span>
  </label>
</div>
            <button type="submit" class="form-submit">Envoyer le message</button>
           <p class="form-notice">Vos données sont traitées conformément à notre <a href="/privacy">politique de confidentialité</a>.</p>
          </form>
        </div>
        
<!-- INFO PRATIQUE -->
<div class="contact-info reveal">
  <h2 class="contact-title">Informations pratiques</h2>

  <div class="info-block">
    <span class="info-label">Adresse</span>
    {contactData.info_practica.direccion.map((linea) => <span>{linea}</span>)}
  </div>

  <div class="info-block">
    <span class="info-label">Métro</span>
    {contactData.info_practica.metro.map((linea) => <span>{linea}</span>)}
  </div>

  <div class="info-block">
    <span class="info-label">Email</span>
    <a href={`mailto:${contactData.info_practica.email}`}>
      {contactData.info_practica.email}
    </a>
  </div>

  <div class="info-block">
    <span class="info-label">Messes en français</span>
    {contactData.info_practica.messes.map((linea) => <span>{linea}</span>)}
  </div>

  <div class="info-block">
    <span class="info-label">Père Rodrigo</span>
    {contactData.info_practica.pere_rodrigo.map((linea) => <span>{linea}</span>)}
  </div>
</div>

<div class="info-block">
  <span class="info-label">WhatsApp</span>
  <a href={contactData.whatsapp.numero_url} target="_blank" rel="noopener noreferrer">
    {contactData.whatsapp.numero_display}
  </a>
  <span>{contactData.whatsapp.texto}</span>
</div>

<div class="info-block">
  <span class="info-label">Newsletter</span>
  <a href={contactData.newsletter_url} target="_blank" rel="noopener noreferrer">
    S'abonner à la newsletter
  </a>
</div>
    </section>

  </main>

  <script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const notice = document.querySelector('.form-notice');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // DÉSACTIVÉ temporairement — domaine Resend non vérifié (voir api/contact.ts).
    // Supprimer ce bloc et décommenter le code ci-dessous quand le domaine sera vérifié.
    if (notice) {
      notice.innerHTML =
        "L'envoi direct n'est pas disponible pour l'instant. " +
        "Contactez-nous par <a href='https://wa.me/34689053259' target='_blank' rel='noopener'>WhatsApp (+34 689 05 32 59)</a> " +
        "ou par email : <a href='mailto:paroissesaintlouismadrid@gmail.com'>paroissesaintlouismadrid@gmail.com</a>.";
    }

    /* À RÉACTIVER quand RESEND_ENABLED = true dans api/contact.ts :
    const fd = new FormData(form);
    const payload = {
      name:    fd.get('name'),
      email:   fd.get('email'),
      subject: fd.get('subject'),
      message: fd.get('message'),
    };

    const res = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      form.reset();
      if (notice) notice.textContent = 'Message envoyé avec succès. Merci !';
    } else {
      if (notice) notice.textContent = 'Erreur lors de l\'envoi. Veuillez réessayer.';
    }
    */
  });
</script>

  <Footer />
</BaseLayout>