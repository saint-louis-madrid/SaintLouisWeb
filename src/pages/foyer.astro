---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import foyer from "../data/foyer/foyer.json";
---

<BaseLayout title="Foyer des jeunes — Saint Louis des Français">
  <Header />

  <main>

    <!-- PAGE HEADER -->
    <div class="page-header">
      <div class="container">
        <span class="eyebrow">JEUNES</span>
        <h1>Foyer des jeunes</h1>
        <p>Un cadre de vie et de mission pour les étudiants catholiques à Madrid.</p>
      </div>
    </div>

<!-- PRÉSENTATION -->
<section class="section">
  <div class="container reveal">
    <div class="foyer-grid">
      <div class="foyer-imagen">
        <img src="/images/foyer.jpg" alt="Foyer des jeunes" />
      </div>
      <div class="text">
        <span class="eyebrow">QU'EST-CE QUE C'EST</span>
        <h2>{foyer.presentacion.titulo}</h2>
        <p>{foyer.presentacion.texto1}</p>
        <p>{foyer.presentacion.texto2}</p>
      </div>
    </div>
  </div>
</section>

    <!-- MISSION -->
    <section class="section">
  <div class="container reveal">
    <span class="eyebrow">MISSION</span>
    <h2 class="section-title">Un lieu de vie et d'engagement</h2>
    <div class="activites-list">
      {foyer.mission.map((item) => (
        <div class="activite-item">
          <div class="activite-meta">
            <span class="activite-titre">{item.titre}</span>
          </div>
          <p>{item.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>

    <!-- PLUS D'INFOS -->
   <section class="cta reveal">
  <div class="container cta-inner">
    <div class="cta-text">
      <h2>{foyer.cta.titulo}</h2>
      <p>{foyer.cta.texto}</p>
    </div>
    <div style="display:flex; gap:1rem; flex-wrap:wrap;">
      <a href={foyer.cta.doc_url}
         target="_blank" rel="noopener noreferrer" class="cta-button">
        {foyer.cta.doc_texto}
      </a>
      <a href="/contact" class="cta-button" style="background: transparent; border: 1px solid var(--color-primary); color: var(--color-primary);">
        Nous contacter
      </a>
    </div>
  </div>
</section>

  </main>

  <Footer />
</BaseLayout>