---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Accueil">
  <Header />

  <main>

    <!-- BANNER RÉNOVATION -->
<div class="banner-renovation reveal">
  <div class="container banner-inner">
    <p>
      🔔 <strong>Projet Rénovation 2026</strong> — Objectif 500 000 € · 
      Aidez-nous à préserver notre église pour les 400 prochaines années.
    </p>
    <a href="/renovation">En savoir plus →</a>
  </div>
</div>
<!-- HERO -->
<section class="hero-carousel">
  <div class="carousel-track" id="carouselTrack">
    <div class="carousel-slide" style="background-image: url('/images/imagenMisa.jpg')"></div>
   
  </div>

  <div class="carousel-overlay">
    <div class="container hero-content">
      <p>Communauté catholique francophone à Madrid</p>
    </div>
  </div>

  <button class="carousel-btn carousel-btn--prev" id="prevBtn">&#8592;</button>
  <button class="carousel-btn carousel-btn--next" id="nextBtn">&#8594;</button>

  <div class="carousel-dots" id="carouselDots">
    <span class="carousel-dot active"></span>
    <span class="carousel-dot"></span>
    <span class="carousel-dot"></span>
    <span class="carousel-dot"></span>
  </div>
</section>



<!-- HORAIRES -->

<section class="section alt horaires">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">LITURGIE</span>
      <h2 class="section-title">Horaires des messes</h2>
    </div>
   <div class="horaires-cols reveal">
  <div class="horaire-col">
    <span class="horaire-day">Dimanche</span>
    <span class="horaire-hour">11h30 · 19h00</span>
    <span class="horaire-note">Messes en français</span>
  </div>
  <div class="horaire-col">
    <span class="horaire-day">Mercredi</span>
    <span class="horaire-hour">20h00</span>
    <span class="horaire-note">Confessions dès 19h</span>
  </div>
  <div class="horaire-col">
    <span class="horaire-day">Jours fériés</span>
    <span class="horaire-hour">11h30</span>
    <span class="horaire-note">Noël, Toussaint, Épiphanie…</span>
  </div>
</div>
    <p class="horaires-extra reveal">
      Messes en espagnol tous les jours à 12h00 — Hogar Residencia San Luis, Claudio Coello 94.
    </p>
  </div>
</section>
    <!-- SECCIÓN 1 -->
    <section class="section">
      <div class="container section-grid">
        <div class="text reveal">
          <span class="eyebrow">LA PAROISSE</span>
          <h2>Une communauté catholique francophone à Madrid</h2>
          <p>
  Fondée en 1613 par Henri de Saureulx, la paroisse Saint Louis des Français 
  est l'une des plus anciennes institutions francophones de Madrid. Rattachée 
  au diocèse de Madrid, elle est installée Calle Lagasca, 89 depuis 1972 et 
  accueille chaque semaine des fidèles de nombreuses nationalités.
</p>
<p>
  Au-delà de la paroisse, l'Œuvre Saint Louis rassemble également un foyer-résidence 
  pour personnes âgées et le Colegio San Luis à Pozuelo. Elle vient en aide 
  à plus de 200 000 € par an aux personnes dans le besoin, sans recevoir 
  aucune subvention. Notre recteur, le père Rodrigo Alfaro Uriarte, 
  accompagne la communauté depuis septembre 2020.
</p>
        </div>

        <div class="image reveal">
          <img src="/logo.jpg" alt="Paroisse" />
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2 -->
    <section class="section alt">
      <div class="container section-grid reverse">
        <div class="image reveal">
          <img src="/images/iglesia.jpg" alt="Communauté" />
        </div>

        <div class="text reveal">
          <span class="eyebrow">LA COMMUNAUTÉ</span>
          <h2>Un lieu de foi, de rencontre et de partage</h2>
         <p>
  Notre paroisse est composée de nombreuses familles avec enfants. 
  Elle propose un accompagnement pour chaque tranche d'âge : éveil à la foi 
  et catéchisme pour les enfants, scouts francophones de 8 à 17 ans, 
  aumônerie collège-lycée, et foyer pour les étudiants et jeunes professionnels.
</p>
<p>
  Pour les adultes et les couples, les équipes Notre-Dame, la préparation 
  aux sacrements et l'animation liturgique rythment la vie paroissiale 
  tout au long de l'année. Une communauté vivante et ouverte à tous 
  les francophones de Madrid.
</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta reveal">
  <div class="container cta-inner">
    <div class="cta-text">
      <h2>Vous souhaitez nous rejoindre ?</h2>
      <p>N'hésitez pas à nous contacter pour toute question.</p>
    </div>
    <a href="/contact" class="cta-button">Nous contacter</a>
  </div>
</section>

    
  </main>

  <Footer />
</BaseLayout>


<script>
  const elements = document.querySelectorAll(".reveal");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
        }
      });
    },
    { threshold: 0.2 }
  );

  elements.forEach((el) => observer.observe(el));
</script>