---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import accueilDataRaw from "../data/index/index.json";
import liturgieDataRaw from "../data/liturgie/liturgie.json";

const accueilData = accueilDataRaw as {
  banner_renovation: { activo: boolean; texto: string; enlace_texto: string; enlace_url: string };
  horaires_resumen: { jour: string; heure: string; note: string }[];
  horaires_nota: string;
  section_paroisse: { titulo: string; texto1: string; texto2: string };
  section_communaute: { titulo: string; texto1: string; texto2: string };
};

const avisoTravaux = (liturgieDataRaw as any).aviso_travaux as {
  activo: boolean;
  texto_intro: string;
  lugares: { horario: string; texto: string }[];
};
---

<BaseLayout title="Accueil">
  <Header />

  <main>

    <!-- BANNER RÉNOVATION -->
    {accueilData.banner_renovation.activo && (
      <div class="banner-renovation reveal">
        <div class="container banner-inner">
          <p>
            🔔 <strong>Projet Rénovation 2026</strong> — {accueilData.banner_renovation.texto}
          </p>
          <a href={accueilData.banner_renovation.enlace_url}>{accueilData.banner_renovation.enlace_texto}</a>
        </div>
      </div>
    )}

    <!-- HERO -->
    <section class="hero-carousel">
      <div class="carousel-track" id="carouselTrack">
        <div class="carousel-slide" style="background-image: url('/images/iglesia.jpg'); background-position: center 55%;"></div>
      </div>

      <div class="carousel-overlay">
        <div class="container hero-content">
          <p>Communauté catholique francophone à Madrid</p>
        </div>
      </div>
    </section>

    <!-- AVISO OBRAS - HORAIRES TEMPORAIRES -->
    {avisoTravaux.activo && (
      <div class="banner-alerte reveal">
        <div class="container banner-alerte-inner">
          <span class="banner-alerte-icon">⚠️</span>
          <div class="banner-alerte-text">
            <p><strong>{avisoTravaux.texto_intro}</strong></p>
            <ul>
              {avisoTravaux.lugares.map((lugar) => (
                <li><strong>{lugar.horario}</strong> — {lugar.texto}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    )}

    <!-- HORAIRES -->
    <section class="section alt horaires">
      <div class="container">
        <div class="reveal">
          <span class="eyebrow">LITURGIE</span>
          <h2 class="section-title">Horaires des messes</h2>
        </div>
        <div class="horaires-cols reveal">
          {accueilData.horaires_resumen.map((h) => (
            <div class="horaire-col">
              <span class="horaire-day">{h.jour}</span>
              <span class="horaire-hour">{h.heure}</span>
              <span class="horaire-note">{h.note}</span>
            </div>
          ))}
        </div>
        <p class="horaires-extra reveal">
          {accueilData.horaires_nota}
        </p>
      </div>
    </section>

    <!-- SECCIÓN 1 -->
    <section class="section">
      <div class="container section-grid">
        <div class="text reveal">
          <span class="eyebrow">LA PAROISSE</span>
          <h2>{accueilData.section_paroisse.titulo}</h2>
          <p>{accueilData.section_paroisse.texto1}</p>
          <p>{accueilData.section_paroisse.texto2}</p>
        </div>

        <div class="image reveal">
          <img src="/logo.jpg" alt="Paroisse" />
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2 -->
    <section class="section alt">
      <div class="container section-grid reverse">
        <div class="image reveal">
          <img src="/images/iglesia.jpg" alt="Communauté" />
        </div>

        <div class="text reveal">
          <span class="eyebrow">LA COMMUNAUTÉ</span>
          <h2>{accueilData.section_communaute.titulo}</h2>
          <p>{accueilData.section_communaute.texto1}</p>
          <p>{accueilData.section_communaute.texto2}</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta reveal">
      <div class="container cta-inner">
        <div class="cta-text">
          <h2>Vous souhaitez nous rejoindre ?</h2>
          <p>N'hésitez pas à nous contacter pour toute question.</p>
        </div>
        <a href="/contact" class="cta-button">Nous contacter</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>


<script>
  const elements = document.querySelectorAll(".reveal");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
        }
      });
    },
    { threshold: 0.2 }
  );

  elements.forEach((el) => observer.observe(el));
</script>