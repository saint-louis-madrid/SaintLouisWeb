---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import liturgieDataRaw from "../data/liturgie/liturgie.json";
const liturgieData = liturgieDataRaw as {
  aviso_travaux: { activo: boolean; texto_intro: string; lugares: { horario: string; texto: string }[] };
  horaires_reguliers: { jour: string; heure: string; note: string }[];
  carnet_chants_url: string;
  messe_familles: string[];
  equipes_liturgiques: { nombre: string; personas: string[] }[];
  jours_feries: { nom: string; fechas: string[] }[];
  note_ete: string;
  semaine_sainte_texto: string;
  semaine_sainte_note: string;
};
---

<BaseLayout title="Liturgie — Saint Louis des Français">
  <Header />

  <main>

    <!-- PAGE HEADER -->
    <div class="page-header">
      <div class="container">
        <span class="eyebrow">LITURGIE</span>
        <h1>Horaires des messes</h1>
        <p>Toutes les célébrations de la paroisse en français.</p>
      </div>
    </div>

    <!-- AVISO OBRAS - HORAIRES TEMPORAIRES -->
    {liturgieData.aviso_travaux.activo && (
      <div class="banner-alerte reveal">
        <div class="container banner-alerte-inner">
          <span class="banner-alerte-icon">⚠️</span>
          <div class="banner-alerte-text">
            <p><strong>{liturgieData.aviso_travaux.texto_intro}</strong></p>
            <ul>
              {liturgieData.aviso_travaux.lugares.map((lugar) => (
                <li><strong>{lugar.horario}</strong> — {lugar.texto}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    )}

    <!-- HORAIRES HABITUELS -->
    <section class="section">
      <div class="container">
        <span class="eyebrow">CHAQUE SEMAINE</span>
        <h2 class="section-title">Messes régulières</h2>
        <div class="horaires-cols reveal">
          {liturgieData.horaires_reguliers.map((h) => (
            <div class="horaire-col">
              <span class="horaire-day">{h.jour}</span>
              <span class="horaire-hour">{h.heure}</span>
              <span class="horaire-note">{h.note}</span>
            </div>
          ))}
        </div>
        <p class="horaires-extra reveal">
          <a href={liturgieData.carnet_chants_url}
            target="_blank" rel="noopener noreferrer">
            Télécharger le carnet de chants →
          </a>
        </p>
      </div>
    </section>

    <!-- MESSES DES FAMILLES -->
    <section class="section">
      <div class="container reveal">
        <span class="eyebrow">CHAQUE MOIS</span>
        <h2 class="section-title">Messe des familles</h2>
        <p class="liturgie-intro">
          Une fois par mois, la messe des familles est célébrée à 11h30, 
          lors d'un dimanche de catéchisme.
        </p>
        <div class="familles-grid">
          {liturgieData.messe_familles.map((fecha) => (
            <div class="famille-card">{fecha}</div>
          ))}
        </div>
      </div>
    </section>

    <!-- ÉQUIPES LITURGIQUES -->
    <section class="section">
      <div class="container reveal">
        <span class="eyebrow">SERVICE LITURGIQUE</span>
        <h2 class="section-title">Équipes liturgiques</h2>
        <p class="liturgie-intro">
          La vie liturgique de la paroisse repose sur l'engagement de nombreux bénévoles.
        </p>
        <div class="jours-grid">
          {liturgieData.equipes_liturgiques.map((equipe) => (
            <div class="jour-card">
              <span class="jour-nom">{equipe.nombre}</span>
              {equipe.personas.map((persona) => (
                <span class="jour-date">{persona}</span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- JOURS SPÉCIAUX -->
    <section class="section">
      <div class="container reveal">
        <span class="eyebrow">JOURS DE FÊTE</span>
        <h2 class="section-title">Jours fériés et solennités</h2>
        <p class="liturgie-intro">
          Les jours de précepte qui ne tombent pas un dimanche sont également célébrés à 11h30.
        </p>
        <div class="jours-grid">
          {liturgieData.jours_feries.map((jour) => (
            <div class="jour-card">
              <span class="jour-nom">{jour.nom}</span>
              {jour.fechas.map((fecha) => (
                <span class="jour-date">{fecha}</span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- NOTE ÉTÉ -->
    <section class="section">
      <div class="container reveal">
        <div class="note-ete">
          <span class="eyebrow">PÉRIODE ESTIVALE</span>
          <p>{liturgieData.note_ete}</p>
        </div>
      </div>
    </section>

    <!-- SEMAINE SAINTE -->
    <section class="section">
      <div class="container reveal">
        <span class="eyebrow">SEMAINE SAINTE</span>
        <h2 class="section-title">Célébrations pascales</h2>
        <p class="liturgie-intro">{liturgieData.semaine_sainte_texto}</p>
        <p class="liturgie-note">{liturgieData.semaine_sainte_note}</p>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>