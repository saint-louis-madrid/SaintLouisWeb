---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import paroisseDataRaw from "../data/paroisse/paroisse.json";

const paroisseData = paroisseDataRaw as {
  histoire: { titulo: string; texto1: string; texto2: string };
  oeuvre: { texto_intro: string; etablissements: { titre: string; linea1: string; linea2: string }[] };
  recteur: { titulo: string; texto1: string; texto2: string };
};
---

<BaseLayout title="Paroisse — Saint Louis des Français">
  <Header />

  <main>

    <div class="page-header">
      <div class="container">
        <span class="eyebrow">LA PAROISSE</span>
        <h1>Saint Louis des Français</h1>
        <p>Une paroisse catholique francophone au cœur de Madrid depuis 1613.</p>
      </div>
    </div>

    <!-- HISTOIRE -->
    <section class="section" id="histoire">
  <div class="container">
    <div class="text reveal">
      <span class="eyebrow">DEPUIS 1613</span>
      <h2>{paroisseData.histoire.titulo}</h2>
      <p>{paroisseData.histoire.texto1}</p>
      <p>{paroisseData.histoire.texto2}</p>
    </div>
  </div>
</section>

    <!-- L'ŒUVRE SAINT LOUIS -->
  <section class="section">
  <div class="container reveal">
    <span class="eyebrow">L'ŒUVRE SAINT LOUIS</span>
    <h2 class="section-title">Une institution au service de tous</h2>
    <p class="liturgie-intro">{paroisseData.oeuvre.texto_intro}</p>
    <div class="oeuvre-grid">
      {paroisseData.oeuvre.etablissements.map((et) => (
        <div class="oeuvre-card">
          <span class="oeuvre-titre">{et.titre}</span>
          <p>{et.linea1}</p>
          <p>{et.linea2}</p>
        </div>
      ))}
    </div>
  </div>
</section>

    <!-- LE RECTEUR -->
   <section class="section">
  <div class="container section-grid reverse">
    <div class="image reveal">
      <img src="/parroquia.jpg" alt="Père Rodrigo" />
    </div>
    <div class="text reveal">
      <span class="eyebrow">NOTRE RECTEUR</span>
      <h2>{paroisseData.recteur.titulo}</h2>
      <p>{paroisseData.recteur.texto1}</p>
      <p>{paroisseData.recteur.texto2}</p>
    </div>
  </div>
</section>

    <!-- ACCÈS -->
    <section class="section">
      <div class="container reveal">
        <span class="eyebrow">ACCÈS</span>
        <h2 class="section-title">Comment nous trouver</h2>
        <div class="acces-grid">
          <div class="acces-info">
            <div class="acces-item">
              <span class="acces-label">Adresse</span>
              <span>Calle Lagasca, 89 · 28006 Madrid</span>
            </div>
    <div class="acces-item">
              <span class="acces-label">Métro</span>
              <span>Nuñez de Balboa (L5 et L9)</span>
              <span>Sortie Juan Bravo</span>
            </div>
            <div class="acces-item">
              <span class="acces-label">Email</span>
              <a href="mailto:paroissesaintlouismadrid@gmail.com">
                paroissesaintlouismadrid@gmail.com
              </a>
            </div>
          </div>
          <div class="acces-map">
            <iframe
              id="google-map"
              data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3036.8!2d-3.6847643!3d40.4321096!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd4228951b99e26f%3A0xdcc82f3e4e56e7f5!2sCalle%20de%20Lagasca%2C%2089%2C%2028006%20Madrid!5e0!3m2!1ses!2ses!4v1"
              width="100%"
              height="260"
              style="border:0; border-radius: 6px;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <p id="map-placeholder" style="display:none; padding:1rem; font-size:0.9rem; color:#666;">
              Acceptez les cookies pour afficher la carte / Acepte las cookies para ver el mapa.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <script>
    function loadMap() {
      const iframe = document.getElementById('google-map') as HTMLIFrameElement;
      const placeholder = document.getElementById('map-placeholder');
      if (iframe && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
        if (placeholder) placeholder.style.display = 'none';
      }
    }

    if (localStorage.getItem('cookieConsent') === 'accepted') {
      loadMap();
    } else {
      const placeholder = document.getElementById('map-placeholder');
      if (placeholder) placeholder.style.display = 'block';
      const acceptBtn = document.getElementById('cookieAccept');
      if (acceptBtn) acceptBtn.addEventListener('click', loadMap);
    }
  </script>

  <Footer />
</BaseLayout>