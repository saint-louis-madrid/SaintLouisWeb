---
const current = Astro.url.pathname;
---

<header>
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="container topbar-inner">
      <a href="/contact">Contact</a>
      <a href="#">FR</a>
      <span>|</span>
      <a href="#">ES</a>
      <a href="#">Instagram</a>
      <a href="https://www.youtube.com/watch?v=BpgVML6todQ" target="_blank" rel="noopener noreferrer">
        Youtube
      </a>
    </div>
  </div>

  <!-- HEADER -->
  <div class="site-header">
    <div class="container header-inner">

      <!-- LOGO -->
      <div class="logo">
        <img src="/logo.jpg" alt="logo" />
        <span>Saint Louis des Français</span>
      </div>

      <!-- BOTÓN MÓVIL -->
      <div class="menu-toggle">☰</div>

      <!-- NAV -->
      <nav class="nav">
        <a href="/" class={current === "/" ? "active" : ""}>Accueil</a>
        <a href="/paroisse" class={current === "/paroisse" ? "active" : ""}>Paroisse</a>
        <a href="/activites" class={current === "/activites" ? "active" : ""}>Activités</a>
        <a href="/liturgie" class={current === "/liturgie" ? "active" : ""}>Liturgie</a>
        <a href="/sacrements" class={current === "/sacrements" ? "active" : ""}>Sacrements</a>
        <a href="/contact" class={current === "/contact" ? "active" : ""}>Contact</a>
      </nav>

    </div>
  </div>
</header>

<!-- JS MENÚ -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.querySelector(".menu-toggle");
    const nav = document.querySelector(".nav");

    if (toggle && nav) {
      toggle.addEventListener("click", () => {
        nav.classList.toggle("open");
      });
    }
  });
</script>